# Keep Linux line endings in every checkout, including Windows: shell scripts, the
# Makefile and Docker builds break on CRLF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.webm binary
*.woff binary
*.woff2 binary
