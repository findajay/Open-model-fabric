# Copy to .env (never commit .env). Values here are read by docker compose and the Makefile.

# API token for the container profile (configs/docker.yaml). At least 16 characters.
OMF_ADMIN_TOKEN=replace-with-a-long-random-token

# Host port the compose stack publishes the API/UI on (127.0.0.1 only). Default 8080.
# OMF_PORT=8080

# Enable the Ollama provider (compose --profile ollama, or a local `ollama serve`).
OMF_ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Where the API keeps SQLite + local artifacts in development.
OMF_DATA_DIR=./var

# Example secret referenced by a provider as `api_key_ref: env:REMOTE_LLM_API_KEY`.
# REMOTE_LLM_API_KEY=

# Google Drive storage (configs/colab-experiment.yaml): service-account JSON *content*.
# GDRIVE_SERVICE_ACCOUNT_JSON=
# GDRIVE_FOLDER_ID=

# PostgreSQL for production-like setups (used via metadata.url_ref).
# OMF_DATABASE_URL=postgresql+psycopg://omf:change-me-local-only@127.0.0.1:5432/omf
