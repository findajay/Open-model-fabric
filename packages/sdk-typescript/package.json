{
  "name": "@omf/sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "TypeScript client for the Open Model Fabric API (types generated from OpenAPI).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } }
  },
  "files": ["dist", "src"],
  "scripts": {
    "generate": "openapi-typescript ../contracts/openapi.json --default-non-nullable false -o src/schema.ts",
    "check-generated": "openapi-typescript ../contracts/openapi.json --default-non-nullable false -o /tmp/omf-schema-check.ts && diff -q src/schema.ts /tmp/omf-schema-check.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
